// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ================================
// INSTITUTION & MANAGEMENT
// ================================

model Institution {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  logo            String?
  address         String?
  phone           String?
  type            String    @default("university") // university, college, organization, company
  joinCode        String    @unique @default(cuid()) // Short code students use to join
  isActive        Boolean   @default(true)
  subscriptionId  String?   @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  subscription      Subscription?
  users             User[]
  branches          Branch[]
  questionBanks     QuestionBank[]
  analytics         InstitutionAnalytics?
  interviewTypes    InterviewType[]
}

// ================================
// BRANCH & SECTION MANAGEMENT
// ================================

model Branch {
  id            String   @id @default(cuid())
  institutionId String
  name          String
  code          String   @unique // unique join code for students, e.g. "CSE001"
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution    Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  sections       BranchSection[]
  users          User[]
  questionBanks  QuestionBank[]
  interviewTypes InterviewType[]

  @@index([institutionId])
}

model BranchSection {
  id          String   @id @default(cuid())
  branchId    String
  name        String
  code        String   @unique // unique join code for students, e.g. "CSE-A01"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  users          User[]
  questionBanks  QuestionBank[]
  interviewTypes InterviewType[]

  @@index([branchId])
}

model Subscription {
  id                String    @id @default(cuid())
  institutionId     String    @unique
  tier              String    @default("free") // free, basic, premium, enterprise
  maxStudents       Int       @default(50)
  maxQuestions      Int       @default(100)
  maxAIInterviewers Int       @default(3)
  features          Json      // Array of enabled features
  startDate         DateTime  @default(now())
  endDate           DateTime?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
}

// ================================
// USER MANAGEMENT
// ================================

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  password        String?
  role            String    @default("student") // student, institution-admin, super-admin
  emailVerified   DateTime?
  image           String?
  
  // Institution fields
  institutionId   String?
  studentId       String?   // Institution-specific student ID
  department      String?
  yearOfStudy     Int?
  branchId        String?   // FK → Branch
  sectionId       String?   // FK → BranchSection
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  institution       Institution?        @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  branch            Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  section           BranchSection?      @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  accounts          Account[]
  sessions          Session[]
  interviewSessions InterviewSession[]
  reports           Report[]
  skillGaps         SkillGap[]
  analytics         Analytics?
  practiceHistory   PracticeHistory[]

  @@index([institutionId])
  @@index([branchId])
  @@index([sectionId])
  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ================================
// QUESTION BANK MANAGEMENT
// ================================

model InterviewType {
  id              String   @id @default(cuid())
  institutionId   String?
  branchId        String?  // if set: only visible to students in this branch
  sectionId       String?  // if set: only visible to students in this section
  name            String   // Technical, Behavioral, System Design, HR, etc.
  description     String?  @db.Text
  icon            String?
  isGlobal        Boolean  @default(false) // Global types available to all institutions
  duration        Int?     // Fixed duration in minutes; set by institution (null = student chooses)
  difficulty      String?  // Fixed difficulty; set by institution (null = student chooses)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  institution       Institution?       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  branch            Branch?            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  section           BranchSection?     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  questionBanks     QuestionBank[]
  interviewSessions InterviewSession[]

  @@index([institutionId])
  @@index([branchId])
  @@index([sectionId])
}

model QuestionBank {
  id              String   @id @default(cuid())
  institutionId   String
  interviewTypeId String
  branchId        String?  // if set: only for this branch
  sectionId       String?  // if set: only for this section
  name            String
  description     String?  @db.Text
  difficulty      String   @default("medium") // easy, medium, hard
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  institution   Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  interviewType InterviewType  @relation(fields: [interviewTypeId], references: [id], onDelete: Cascade)
  branch        Branch?        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  section       BranchSection? @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  questions     Question[]

  @@index([institutionId])
  @@index([interviewTypeId])
  @@index([branchId])
  @@index([sectionId])
}

model Question {
  id              String   @id @default(cuid())
  questionBankId  String
  question        String   @db.Text
  expectedAnswer  String?  @db.Text
  keyPoints       Json?    // Array of key points to cover
  difficulty      String   @default("medium") // easy, medium, hard
  timeAllocation  Int      @default(5) // in minutes
  tags            Json?    // Array of tags like ["javascript", "async", "promises"]
  order           Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  questionBank QuestionBank @relation(fields: [questionBankId], references: [id], onDelete: Cascade)

  @@index([questionBankId])
}

// ================================
// AI INTERVIEWER SYSTEM
// ================================

model AIInterviewer {
  id               String   @id @default(cuid())
  name             String
  personality      String   // Friendly, Professional, Strict, Casual, Encouraging
  description      String   @db.Text
  avatar           String   // URL to avatar image
  voice            String   // Voice identifier for TTS
  expertise        Json     // Array of expertise areas
  greetingMessage  String   @db.Text
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  interviewSessions InterviewSession[]
}

// ================================
// INTERVIEW SESSIONS
// ================================

model InterviewSession {
  id                String    @id @default(cuid())
  userId            String
  interviewTypeId   String
  aiInterviewerId   String
  
  title             String
  difficulty        String    // easy, medium, hard
  duration          Int       // in minutes
  
  // Session tracking
  status            String    @default("pending") // pending, in-progress, completed, cancelled
  startedAt         DateTime?
  completedAt       DateTime?
  
  // Results
  score             Float?
  feedback          String?   @db.Text
  conversationLog   Json?     // Array of {speaker, message, timestamp}
  
  // Recording
  videoRecording    String?   // URL to video recording
  audioRecording    String?   // URL to audio recording
  
  // Metadata
  questionsAsked    Json      // Array of questions asked with answers
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  interviewType InterviewType @relation(fields: [interviewTypeId], references: [id], onDelete: Cascade)
  aiInterviewer AIInterviewer @relation(fields: [aiInterviewerId], references: [id], onDelete: Cascade)
  report        Report?

  @@index([userId])
  @@index([interviewTypeId])
  @@index([aiInterviewerId])
}

// ================================
// ANALYTICS & REPORTS
// ================================

model Report {
  id                  String   @id @default(cuid())
  userId              String
  interviewSessionId  String   @unique
  overallScore        Float
  strengths           Json     // Array of strength areas
  weaknesses          Json     // Array of weakness areas
  recommendations     Json     // Array of recommendations
  detailedAnalysis    String   @db.Text
  skillBreakdown      Json?    // Breakdown by skill categories
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  interviewSession InterviewSession @relation(fields: [interviewSessionId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SkillGap {
  id           String   @id @default(cuid())
  userId       String
  skillName    String
  category     String   // programming, communication, problem-solving, etc.
  currentLevel Int      // 1-10
  targetLevel  Int      // 1-10
  priority     String   @default("medium") // low, medium, high
  resources    Json     // Array of learning resources
  progress     Int      @default(0) // 0-100
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Analytics {
  id                    String    @id @default(cuid())
  userId                String    @unique
  totalInterviews       Int       @default(0)
  averageScore          Float     @default(0)
  interviewsThisWeek    Int       @default(0)
  interviewsThisMonth   Int       @default(0)
  strongestCategory     String?
  weakestCategory       String?
  improvementRate       Float     @default(0) // percentage
  lastInterviewDate     DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InstitutionAnalytics {
  id                      String   @id @default(cuid())
  institutionId           String   @unique
  totalStudents           Int      @default(0)
  activeStudents          Int      @default(0)
  totalInterviews         Int      @default(0)
  averageScore            Float    @default(0)
  totalQuestions          Int      @default(0)
  mostUsedInterviewType   String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
}

model PracticeHistory {
  id              String   @id @default(cuid())
  userId          String
  activityType    String   // interview, practice-question, mock-test
  topic           String
  duration        Int      // in minutes
  score           Float?
  completedAt     DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([completedAt])
}
